$giper_baza_rich_edit $mol_view
	pawn? $giper_baza_rich
	attr *
		^
		giper_baza_rich_edit_enabled <= enabled true
	hint \
	auto /
		<= selection_load null
		<= selection_sync null
	plugins /
		<= Inline_toggle $mol_hotkey
			mod_ctrl true
			key *
				B? <=> inline_toggle*strong? null - \Brutal
				I? <=> inline_toggle*em? null - \Ironic
				U? <=> inline_toggle*ins? null - \Update
				O? <=> inline_toggle*del? null - \Omit
				M? <=> inline_toggle*code? null - \Monospace
		<= Block_more $mol_hotkey
			mod_ctrl true
			key * Q? <=> block_more*blockquote? null - \Quote
		<= Block_less $mol_hotkey
			mod_ctrl true
			mod_shift true
			key * Q? <=> block_less*blockquote? null - \Quote
		<= Indent_more $mol_hotkey
			key * tab? <=> block_more*ul? null - \Indent
		<= Indent_less $mol_hotkey
			mod_shift true
			key * tab? <=> block_less*ul? null - \Indent
	sub /
		<= Tools $mol_float sub /
			<= Inline_format_menu $mol_pick
				hint @ \Inline Formating
				trigger_content /
					<= Inline_format_menu_icon $mol_icon_marker
				bubble_content /
					<= Strong_button $mol_button_minor
						title @ \Strong
						hint \Ctrl+B
						enabled? <=> selected? false
						click? <=> inline_toggle*strong?
					<= Em_button $mol_button_minor
						title @ \Emphasis
						hint \Ctrl+I
						enabled? <=> selected? false
						click? <=> inline_toggle*em?
					<= Ins_button $mol_button_minor
						title @ \Insertion
						hint \Ctrl+U
						enabled? <=> selected? false
						click? <=> inline_toggle*ins?
					<= Del_button $mol_button_minor
						title @ \Deletion
						hint \Ctrl+O
						enabled? <=> selected? false
						click? <=> inline_toggle*del?
					<= Code_button $mol_button_minor
						title @ \Code
						hint \Ctrl+M
						enabled? <=> selected? false
						click? <=> inline_toggle*code?
			<= Heading_menu $mol_pick
				hint @ \Heading
				trigger_content /
					<= Heading_menu_icon $mol_icon_format_size
				bubble_content /
					<= Header_inc_button $mol_button_minor
						title @ \Increase
						hint \Ctrl+H
						enabled false
					<= Header_dec_button $mol_button_minor
						title @ \Decrease
						hint \Ctrl+Shift+H
						enabled false
			<= Indent_menu $mol_pick
				hint @ \Indentation
				trigger_content /
					<= Indent_menu_icon $mol_icon_format_list_bulleted
				bubble_content /
					<= Indent_inc_button $mol_button_minor
						title @ \Increase
						hint \Ctrl+Tab
						enabled? <=> selected? false
						click? <=> block_more*ul?
					<= Indent_dec_button $mol_button_minor
						title @ \Decrease
						hint \Ctrl+Shift+Tab
						enabled? <=> selected? false
						click? <=> block_less*ul?
					<= Bullet_button $mol_button_minor
						title @ \Bullets
						hint \Ctrl+8
						enabled false
					<= Number_button $mol_button_minor
						title @ \Numbers
						hint \Ctrl+1
						enabled false
			<= Quote_menu $mol_pick
				hint @ \Quotation
				trigger_content /
					<= Quote_menu_icon $mol_icon_comment_quote_outline
				bubble_content /
					<= Quote_inc_button $mol_button_minor
						title @ \Increase
						hint \Ctrl+Q
						enabled? <=> selected? false
						click? <=> block_more*blockquote?
					<= Quote_dec_button $mol_button_minor
						title @ \Decrease
						hint \Ctrl+Shift+Q
						enabled? <=> selected? false
						click? <=> block_less*blockquote?
					<= Quote_code_button $mol_button_minor
						title @ \Code
						hint \Ctrl+3
						enabled false
		<= Content $mol_view
			attr *
				contenteditable <= editable? \true
			event *
				input? <=> save? null
				paste? <=> paste? null
				pointermove? <=> hover? null
			sub <= content /
